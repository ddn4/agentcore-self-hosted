      "n": 7,
      "title": "Support replies with the refund ID",
      "kind": "watch",
      "done_when": "run.status==COMPLETED",
      "talk": "Same build, pinned: support-supervisor:4ee7f87.",
      "make": "make result WF=support-2077-wci-k3f9"
     },
     {
      "id": "report",
      "n": 8,
      "title": "Read the report",
      "kind": "watch",
      "done_when": "run.closed",
      "talk": "Two lifetimes, one Build ID, reply seconds after the approval.",
      "make": "uv run --frozen python scripts/serverless_report.py support-2077-wci-k3f9"
     }
